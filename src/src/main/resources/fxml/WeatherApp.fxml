<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.weatherapp.WeatherAppController"
      styleClass="weather-app"
      prefWidth="1000" prefHeight="700">
    
    <!-- Header -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
        <!-- Logo -->
        <HBox styleClass="logo-container">
            <Label text="🌤️" styleClass="logo-icon"/>
            <Label text="Just Weather" styleClass="logo-text"/>
        </HBox>
        
        <!-- Search Container -->
        <StackPane styleClass="search-container" HBox.hgrow="ALWAYS">
            <TextField fx:id="searchField" promptText="Search for cities..." styleClass="search-field"/>
            <Label text="🔍" styleClass="search-icon" StackPane.alignment="CENTER_LEFT"/>
        </StackPane>
        
        <!-- Controls -->
        <HBox styleClass="controls-container">
            <!-- Dark Mode Toggle -->
            <Button fx:id="darkModeToggle" styleClass="dark-mode-toggle">
                <graphic>
                    <Label fx:id="darkModeIcon" text="🌙"/>
                </graphic>
            </Button>
            
            <!-- Temperature Toggle -->
            <HBox styleClass="temp-toggle">
                <ToggleButton fx:id="celsiusBtn" text="°C" styleClass="temp-btn" selected="true"/>
                <ToggleButton fx:id="fahrenheitBtn" text="°F" styleClass="temp-btn"/>
            </HBox>
        </HBox>
    </HBox>
    
    <!-- Main Content -->
    <ScrollPane fitToWidth="true" styleClass="main-scroll" VBox.vgrow="ALWAYS">
        <VBox styleClass="main-content">
            <!-- Loading Overlay -->
            <StackPane fx:id="loadingOverlay" styleClass="loading-overlay" visible="false" managed="false">
                <VBox styleClass="loading-spinner" alignment="CENTER" spacing="16">
                    <ProgressIndicator fx:id="progressIndicator" styleClass="progress-indicator"/>
                    <Label fx:id="loadingText" text="Loading weather data..." styleClass="loading-text"/>
                </VBox>
            </StackPane>
            
            <!-- Error Container -->
            <VBox fx:id="errorContainer" styleClass="error-container" visible="false" managed="false" spacing="16">
                <Label text="⚠️" styleClass="error-icon"/>
                <Label fx:id="errorTitle" text="Unable to load weather data" styleClass="error-title"/>
                <Label fx:id="errorMessage" text="Please check your internet connection and try again." styleClass="error-message"/>
                <Button fx:id="retryButton" text="Retry" styleClass="retry-button"/>
            </VBox>
            
            <!-- Success Message -->
            <HBox fx:id="successContainer" styleClass="success-container" visible="false" managed="false" spacing="12">
                <Label text="✅" style="-fx-font-size: 16px;"/>
                <Label fx:id="successText" text="Weather data updated successfully!" styleClass="success-text"/>
            </HBox>
            
            <!-- Current Weather Section -->
            <VBox fx:id="currentWeatherContainer" styleClass="current-weather fade-in" spacing="16">
                <Label fx:id="cityLabel" text="Madrid" styleClass="city-name"/>
                <HBox styleClass="weather-main-info">
                    <VBox styleClass="temperature-container">
                        <Label fx:id="temperatureLabel" text="16°" styleClass="temperature"/>
                        <HBox styleClass="temperature-range" spacing="8">
                            <Label fx:id="maxTempLabel" text="H: 18°" styleClass="max-temp"/>
                            <Label fx:id="minTempLabel" text="L: -1°" styleClass="min-temp"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox styleClass="weather-icon-container" alignment="CENTER">
                        <Label fx:id="weatherIcon" text="⛅" styleClass="weather-icon"/>
                        <Label fx:id="weatherDescription" text="Partly Cloudy" styleClass="weather-description"/>
                    </VBox>
                </HBox>
            </VBox>
            
            <!-- Today's Forecast -->
            <VBox fx:id="forecastContainer" styleClass="forecast-section slide-in-up" spacing="16">
                <Label text="HOURLY FORECAST" styleClass="section-title"/>
                <ScrollPane styleClass="forecast-scroll" fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                    <HBox fx:id="hourlyForecastContainer" styleClass="hourly-forecast"/>
                </ScrollPane>
            </VBox>
            
            <!-- Weather Details -->
            <VBox fx:id="detailsContainer" styleClass="details-section slide-in-up" spacing="16">
                <Label text="WEATHER DETAILS" styleClass="section-title"/>
                <GridPane fx:id="detailsGrid" styleClass="details-grid">
                    <!-- Details will be populated by controller -->
                </GridPane>
            </VBox>
            
            <!-- Air Quality Section -->
            <VBox fx:id="airQualityContainer" styleClass="details-section slide-in-up" spacing="16" visible="false" managed="false">
                <Label text="AIR QUALITY" styleClass="section-title"/>
                <GridPane fx:id="airQualityGrid" styleClass="details-grid">
                    <!-- Air quality details will be populated by controller -->
                </GridPane>
            </VBox>
        </VBox>
    </ScrollPane>
    
</VBox>